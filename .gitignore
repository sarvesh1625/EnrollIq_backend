# ─── Dependencies ───────────────────────────────
node_modules/

# ─── Environment / secrets (NEVER commit) ───────
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Logs ───────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS files ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editors ────────────────────────────────────
.vscode/
.idea/
*.swp

# ─── Uploaded / generated files ─────────────────
uploads/
dist/
build/
tmp/

# ─── One-off debug & inspection scripts ─────────
# (throwaway helpers we made while troubleshooting — not part of the app)
check_*.js
debug_*.js
dump*.ps1
reset_*.js
test_*.js
set_plan.js
wipe_data.js

# NOTE: migration & schema scripts are intentionally NOT ignored —
# runAiExamSchema.js, migrate_*.js, backfill*.js stay in the repo
# because you may need to run them to set up the database.